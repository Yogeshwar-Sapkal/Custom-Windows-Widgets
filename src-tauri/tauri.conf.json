{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "World Clock",
  "version": "0.1.0",
  "identifier": "com.personal.worldclock",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "world-clock",
        "title": "World Clock",
        "width": 260,
        "height": 190,
        "minWidth": 120,
        "minHeight": 70,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "shadow": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "url": "widgets/world-clock/index.html"
      },
      {
        "label": "weather",
        "title": "Weather",
        "width": 360,
        "height": 560,
        "minWidth": 200,
        "minHeight": 200,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "shadow": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "url": "widgets/weather/index.html",
        "visible": false
      },
      {
        "label": "battery",
        "title": "Battery",
        "width": 300,
        "height": 220,
        "minWidth": 180,
        "minHeight": 100,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "shadow": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "url": "widgets/battery/index.html",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://api.open-meteo.com https://geocoding-api.open-meteo.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
